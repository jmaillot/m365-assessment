# M365-Assess Web — environment template.
# Copy to `.env` (gitignored) and fill in values:
#   cp .env.example .env
# `docker compose up` sources this file via env_file. Never commit real values.

# Public base URL of the app. Used to build OAuth redirect URIs.
APP_BASE_URL=http://localhost:3000

# Provider multi-tenant app — register ONCE in YOUR (operator) Entra tenant
# per docs/web/APP-REGISTRATION-SETUP.md §A. Customers never create an app.
# The server auto-bootstraps this secret into encrypted storage on first boot
# (web/src/db/index.ts:38); the Settings wizard then shows "Configured" and
# is only for rotation. Consumed by Plans 01-03/01-04 + all assessments.
AZURE_CLIENT_ID=

# Provider client secret Value (not Secret ID) — server-only, never shown to
# customers. Put it here AND the server will encrypt it at rest (AES-GCM).
# Rotate via Settings → Operator credential → Rotate, or replace here + restart.
AZURE_CLIENT_SECRET=

# Authority for sign-in and admin consent: `organizations` = work/school only
# (D-04 rejects personal accounts). Consumed by Plans 01-03/01-04.
AZURE_AUTHORITY=https://login.microsoftonline.com/organizations

# Session signing secret (generate e.g. with `openssl rand -base64 32`).
# Consumed by Plan 01-03 session handling.
SESSION_SECRET=

# Encryption key for server-side storage at rest (AES-256-GCM, 32 bytes).
# Encrypts BOTH tenant refresh tokens AND the provider client secret
# (operator_credential). Generate: openssl rand -hex 32 — 64 hex chars.
ENCRYPTION_KEY=

# SQLite database file location. In Docker this must stay under /app/data
# (the persistent volume). Local non-Docker override: ./data/m365-assess.db
DATABASE_PATH=/app/data/m365-assess.db

# Operator admin allowlist — only these Entra work-account emails may view
# Settings and rotate the provider client secret (POST/DELETE
# /api/settings/operator-credential). Comma/semicolon separated. If empty,
# any signed-in user is allowed (dev). In prod set to your email.
OPERATOR_ADMIN_EMAILS=
